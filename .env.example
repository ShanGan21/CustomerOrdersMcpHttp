SERVER_PORT=2323
SERVER_HOST=localhost

# MCP Configuration
MCP_PROXY_URL=http://localhost:6274

# Optional: Add API keys or tokens here if needed
# API_KEY=your_api_key_here
# MCP_AUTH_TOKEN=your_auth_token_here
